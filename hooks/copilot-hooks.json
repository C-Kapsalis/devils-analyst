{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "cat \"$PLUGIN_ROOT/hooks/core.md\" || exit 0",
        "powershell": "$f = \"$env:PLUGIN_ROOT/hooks/core.md\"; if (Test-Path -LiteralPath $f) { Get-Content -Raw -LiteralPath $f -ErrorAction SilentlyContinue }; exit 0",
        "timeoutSec": 5
      }
    ]
  }
}
